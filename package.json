{
  "name": "curxx-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test MONGODB_DB=curxx_test JWT_SECRET=test-secret-at-least-16 tsx src/db/seed.ts && NODE_ENV=test MONGODB_DB=curxx_test JWT_SECRET=test-secret-at-least-16 ADMIN_EMAIL=admin@curxx.test ADMIN_PASSWORD=test-admin-password tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.1.0",
    "mongoose": "^8.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
