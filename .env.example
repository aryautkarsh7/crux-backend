# Leave MONGODB_URI empty in development: a local MongoDB is downloaded and started automatically.
# For production use a MongoDB Atlas connection string.
MONGODB_URI=
PORT=4000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-in-production
# Comma-separated origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000
# Generated sample doctors, facilities, reviews and testimonials. Off (the default) shows only imported and
# admin-added records; true shows the sample data too (tests and demos).
SHOW_SAMPLE_DATA=false

# Message Central VerifyNow credentials
MSGCENTRAL_CUSTOMER_ID=
MSGCENTRAL_BASE64_KEY=
MSGCENTRAL_EMAIL=
MSGCENTRAL_COUNTRY=IN
