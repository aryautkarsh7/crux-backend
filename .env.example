# Curxx API: copy to .env and fill values. Values without quotes. Never commit .env.
# Production values live in Railway > crux-backend > Variables (see the handover README).

# Runtime mode: development | test | production.
NODE_ENV=development
# Port the API listens on (Railway sets it in production).
PORT=4000
# Node options (read by Node, not the app); production uses --max-old-space-size=1536.
# NODE_OPTIONS=--max-old-space-size=1536
# Time zone for slots and "today".
TZ=Asia/Kolkata

# Atlas connection string; leave empty locally to use the built-in local MongoDB. <SECRET> in production.
MONGODB_URI=
# Local MongoDB database name (used only when MONGODB_URI is empty).
MONGODB_DB=curxx
# Local MongoDB port (used only when MONGODB_URI is empty).
MONGODB_PORT=27017
# Folder for the local MongoDB data (used only when MONGODB_URI is empty).
MONGODB_DATA_PATH=.data/mongo
# Any value makes `npm run seed` print the catalogue sync.
SEED_VERBOSE=

# Signs login tokens, 16+ characters. <SECRET>: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<SECRET>
# Sites allowed to call the API, comma-separated; the first is the website.
CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# Admin panel login email. <SECRET>: admin sign-in stays off until both are valid.
ADMIN_EMAIL=<SECRET>
# Admin panel password, 10+ characters. <SECRET>
ADMIN_PASSWORD=<SECRET>

# Message Central customer id for OTP login. <SECRET>; empty locally returns a dev code instead.
MSGCENTRAL_CUSTOMER_ID=
# Message Central base64 key for OTP login. <SECRET>
MSGCENTRAL_BASE64_KEY=
# Message Central account email. <SECRET>
MSGCENTRAL_EMAIL=
# Country code for the Message Central token call (India is 91).
MSGCENTRAL_COUNTRY=91

# Doctar read-only database URL; empty turns the directory off. <SECRET>
DOCTAR_DB_URL=
# Set false to turn the Doctar directory off even when DOCTAR_DB_URL is set.
DOCTAR_ENABLED=true
# Only Doctar's admin-verified doctors.
DOCTAR_VERIFIED_ONLY=true
# Show doctors' own Doctar photos (false = generic avatar).
DOCTAR_SHOW_DOCTOR_PHOTOS=true
# Show hospitals' own Doctar photos (many are scraped, so off by default).
DOCTAR_SHOW_FACILITY_PHOTOS=false
# Minutes between full rebuilds of the Doctar listing index (5 to 1440).
DOCTAR_REFRESH_MINUTES=60
# Records per read while building the index (100 to 5000).
DOCTAR_PAGE_SIZE=1000
# Cap on doctors held in memory (0 = no cap).
DOCTAR_MAX_DOCTORS=0
# Doctar database timeout in milliseconds (1000 to 120000).
DOCTAR_TIMEOUT_MS=15000
# Seconds a profile or hospital page from Doctar is reused (0 to 86400).
DOCTAR_DETAIL_TTL_SECONDS=600
# Connections to the Doctar database (1 to 20).
DOCTAR_POOL_SIZE=3

# Booking notifications: log (log only) | test (all to TEST_NOTIFY_*) | live (real doctors, production only).
NOTIFY_MODE=test
# Phone that receives test-mode notifications.
TEST_NOTIFY_PHONE=
# Email that receives test-mode notifications.
TEST_NOTIFY_EMAIL=
# Resend API key for email; empty = emails are skipped and logged. <SECRET>
RESEND_API_KEY=
# Sender of notification emails (use a verified domain for live).
NOTIFY_EMAIL_FROM=Curxx <onboarding@resend.dev>
# true = Doctar doctors take booking requests instead of Call / Visit only.
IMPORTED_BOOKABLE=false

# SMS provider name; only "log" exists today.
SMS_PROVIDER=log
# SMS provider API key (read but not used yet). <SECRET>
SMS_API_KEY=
# SMS sender id (for a future provider).
SMS_SENDER_ID=
# DLT entity id (for a future provider).
SMS_DLT_ENTITY_ID=
# DLT template id (for a future provider).
SMS_DLT_TEMPLATE_ID=
# DLT template id used in test mode (for a future provider).
SMS_DLT_TEST_TEMPLATE_ID=

# true = also show the generated sample doctors, facilities and reviews (tests and demos).
SHOW_SAMPLE_DATA=false
