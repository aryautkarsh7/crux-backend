# Leave MONGODB_URI empty in development: a local MongoDB is downloaded and started automatically.
# For production use a MongoDB Atlas connection string.
MONGODB_URI=
PORT=4000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-in-production
# Comma-separated origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000
