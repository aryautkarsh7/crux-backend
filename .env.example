# Curxx API settings. Every variable the code reads (src/config/env.ts). Copy to .env for local work.
# Values without quotes. Never commit real values. Production values live in Railway > crux-backend > Variables.
# Secrets are left empty here (an empty value is the safe local default); production needs the <SECRET: ...> noted.

# ---- Core ----
NODE_ENV=development
# Set by Railway in production; 4000 locally.
PORT=4000
# Production only (read by Node itself): --max-old-space-size=1536
# NODE_OPTIONS=
# Leave empty in development: a local MongoDB is started automatically.
# Production: <SECRET: Atlas connection string for the live "curxx" database> (DB name from the URI path).
MONGODB_URI=
# 16+ characters. Production: <SECRET: new random string>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-in-production
# Comma-separated origins allowed to call this API; the first is the website.
# Production: https://curxx-frontend.vercel.app,https://admin-curxx.vercel.app
CORS_ORIGIN=http://localhost:3000

# ---- Admin panel login (admin sign-in is off without both) ----
# Production: admin@curxx.in
ADMIN_EMAIL=
# 10+ characters. Production: <SECRET: admin panel password>
ADMIN_PASSWORD=

# ---- Patient OTP via Message Central VerifyNow ----
# Empty in development: the API returns a dev code instead. Required in production (OTP fails without them).
# Production: <SECRET: Message Central customer id>
MSGCENTRAL_CUSTOMER_ID=
# Production: <SECRET: Message Central base64 key>
MSGCENTRAL_BASE64_KEY=
# Production: <SECRET: Message Central account email>
MSGCENTRAL_EMAIL=
# Code default is IN; production uses 91.
MSGCENTRAL_COUNTRY=91

# ---- Doctar directory (Doctar's DB is READ-ONLY for Curxx) ----
# Empty = directory off. Production: <SECRET: read-only connection string to Doctar's database>
DOCTAR_DB_URL=
DOCTAR_ENABLED=true
# Production: true
DOCTAR_VERIFIED_ONLY=false
DOCTAR_SHOW_DOCTOR_PHOTOS=true
DOCTAR_SHOW_FACILITY_PHOTOS=false
DOCTAR_REFRESH_MINUTES=60
DOCTAR_PAGE_SIZE=1000
# 0 = no cap.
DOCTAR_MAX_DOCTORS=0
DOCTAR_TIMEOUT_MS=15000
DOCTAR_DETAIL_TTL_SECONDS=600
DOCTAR_POOL_SIZE=3

# ---- Booking requests / notifications ----
# log | test (everything to TEST_NOTIFY_*) | live (real doctors; only with NODE_ENV=production)
NOTIFY_MODE=test
TEST_NOTIFY_PHONE=
TEST_NOTIFY_EMAIL=
# Email via Resend; empty = emails skipped and logged. Production: <SECRET: Resend API key>
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Curxx <onboarding@resend.dev>
IMPORTED_BOOKABLE=false

# ---- SMS for booking requests (only "log" exists today; the SMS_* values are not used yet) ----
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
SMS_DLT_TEST_TEMPLATE_ID=

# ---- Other ----
# Generated sample doctors, facilities, reviews and testimonials; true for tests and demos.
SHOW_SAMPLE_DATA=false
TZ=Asia/Kolkata

# ---- Local development / tests only ----
MONGODB_DB=curxx
MONGODB_PORT=27017
MONGODB_DATA_PATH=.data/mongo
# Any value prints the catalogue sync while seeding.
SEED_VERBOSE=
